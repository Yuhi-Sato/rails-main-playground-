<div class="flex items-center justify-between rounded-xl border border-slate-200 bg-white px-4 py-3">
  <div class="flex items-center gap-3">
    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold <%= color_class %>">
      <%= skill.category.capitalize %>
    </span>
    <span class="font-medium text-slate-800"><%= skill.name %></span>
  </div>
  <div class="flex items-center gap-1" aria-label="Level <%= filled_dots %> out of 5">
    <% filled_dots.times do %>
      <span class="h-2.5 w-2.5 rounded-full bg-indigo-500"></span>
    <% end %>
    <% empty_dots.times do %>
      <span class="h-2.5 w-2.5 rounded-full bg-slate-200"></span>
    <% end %>
  </div>
</div>
