<% content_for :title, "Blog — #{site.owner_name}" %>

<section class="mx-auto max-w-3xl px-4 py-16">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Blog</h1>
  <p class="mt-3 text-slate-600">Notes on Rails, Ruby, and the teams that ship them.</p>

  <%= form_with url: posts_path, method: :get, local: true, class: "mt-6" do |f| %>
    <div class="flex gap-2">
      <%= f.text_field :q, value: @query, placeholder: "Search posts…",
            class: "flex-1 rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
      <%= f.submit "Search", class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer" %>
    </div>
  <% end %>

  <% if @posts.any? %>
    <div class="mt-10 grid grid-cols-1 gap-6">
      <% @posts.each do |post| %>
        <%= render PostCardComponent.new(post: post) %>
      <% end %>
    </div>

    <nav class="mt-8 flex items-center justify-center gap-2 text-sm">
      <%== pagy_nav(@pagy) %>
    </nav>
  <% else %>
    <p class="mt-10 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">
      <% if @query.present? %>
        No posts match <q><%= @query %></q>.
      <% else %>
        No posts yet.
      <% end %>
    </p>
  <% end %>
</section>
