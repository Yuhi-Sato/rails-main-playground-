<% content_for :title, "Contact — #{site.owner_name}" %>

<section class="mx-auto max-w-xl px-4 py-16">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">Get in touch</h1>
  <p class="mt-3 text-slate-600">
    Say hello at <%= mail_to site.owner_email, site.owner_email, class: "text-indigo-600 hover:text-indigo-800" %> or use the form below.
  </p>

  <%= form_with model: @contact, url: contact_path, local: true, class: "mt-8 space-y-5" do |f| %>
    <% if @contact.errors.any? %>
      <div class="rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800">
        <p class="font-semibold">Please fix the following:</p>
        <ul class="mt-1 list-disc pl-5">
          <% @contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :name, class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :message, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_area :message, rows: 6, class: "mt-1 block w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>

    <%= f.submit "Send message", class: "inline-flex items-center rounded-full bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow hover:bg-indigo-500 cursor-pointer" %>
  <% end %>
</section>
