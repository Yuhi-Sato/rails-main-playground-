<article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition">
  <header class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold text-slate-900"><%= project.title %></h3>
    <% if project.featured %>
      <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800">★ Featured</span>
    <% end %>
  </header>

  <p class="mt-3 text-sm leading-relaxed text-slate-600">
    <%= truncate(project.description.to_s, length: 180) %>
  </p>

  <% if tech_chips.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% tech_chips.each do |tech| %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">
          <%= tech %>
        </span>
      <% end %>
    </div>
  <% end %>

  <footer class="mt-5 flex items-center gap-4 text-sm">
    <% if project.url.present? %>
      <%= link_to "Visit →", project.url, class: "font-medium text-indigo-600 hover:text-indigo-800", target: "_blank", rel: "noopener" %>
    <% end %>
    <% if project.github_url.present? %>
      <%= link_to "GitHub", project.github_url, class: "text-slate-500 hover:text-slate-700", target: "_blank", rel: "noopener" %>
    <% end %>
  </footer>
</article>
