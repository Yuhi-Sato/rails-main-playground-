<%= link_to post_path(post), class: "block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm hover:shadow-md transition" do %>
  <p class="text-xs font-medium uppercase tracking-wider text-indigo-600"><%= formatted_date %></p>
  <h3 class="mt-1 text-xl font-semibold text-slate-900"><%= post.title %></h3>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">
    <%= truncate(excerpt, length: 200) %>
  </p>
  <% if post.tags.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% post.tags.each do |tag| %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">#<%= tag %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
