<% content_for :title, "About — #{site.owner_name}" %>

<section class="mx-auto max-w-3xl px-4 pt-16 pb-10">
  <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">About <%= site.owner_name %></h1>
  <p class="mt-4 text-lg leading-relaxed text-slate-600 whitespace-pre-line"><%= site.bio %></p>

  <dl class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Role</dt>
      <dd class="mt-1 text-slate-900"><%= site.owner_role %></dd>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4">
      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-500">Location</dt>
      <dd class="mt-1 text-slate-900"><%= site.owner_location %></dd>
    </div>
  </dl>
</section>

<section class="mx-auto max-w-3xl px-4 py-10">
  <h2 class="text-2xl font-bold text-slate-900">Skills</h2>

  <% if @skills_by_category.any? %>
    <% @skills_by_category.each do |category, skills| %>
      <div class="mt-6">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-500"><%= category.capitalize %></h3>
        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <% skills.each do |skill| %>
            <%= render SkillBadgeComponent.new(skill: skill) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p class="mt-4 rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-500">
      Skills list is being curated.
    </p>
  <% end %>
</section>
