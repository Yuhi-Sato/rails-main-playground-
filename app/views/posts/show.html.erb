<% content_for :title, "#{@post.title} — #{site.owner_name}" %>

<article class="mx-auto max-w-3xl px-4 py-16">
  <%= link_to "← All posts", posts_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-800" %>
  <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-indigo-600">
    <%= @post.published_at&.strftime("%Y-%m-%d") || "Draft" %>
  </p>
  <h1 class="mt-1 text-4xl font-extrabold tracking-tight text-slate-900"><%= @post.title %></h1>

  <% if @post.tags.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @post.tags.each do |tag| %>
        <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-700">#<%= tag %></span>
      <% end %>
    </div>
  <% end %>

  <div class="prose prose-slate mt-8 max-w-none whitespace-pre-line leading-relaxed text-slate-700">
    <%= @post.body %>
  </div>
</article>
